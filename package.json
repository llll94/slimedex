{
  "name": "slime-overlay",
  "version": "1.5.2",
  "description": "Slimedex — overlay de consulta para World of Slime: busca rápida por Ctrl+Tab, combinações, chances e elementos de cada slime.",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable",
    "dist:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^24.13.3"
  },
  "allowScripts": {
    "electron@33.4.11": true
  },
  "build": {
    "appId": "io.github.llll94.slimedex",
    "productName": "Slimedex",
    "files": [
      "main.js",
      "preload.js",
      "atualizador.js",
      "overlay.html",
      "pin.html",
      "i18n.js",
      "data.js",
      "comunidade.json",
      "icon.png",
      "icon.svg"
    ],
    "win": {
      "target": "portable",
      "icon": "icon.png"
    },
    "portable": {
      "artifactName": "Slimedex-${version}-portable.exe"
    },
    "afterPack": "scripts/assinar-adhoc.js",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon-mac.png",
      "category": "public.app-category.games",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "Slimedex-${version}-mac-${arch}.${ext}"
    }
  }
}
