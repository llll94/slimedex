{
  "name": "slime-overlay",
  "version": "1.2.0",
  "description": "Slimedex — overlay de consulta para World of Slime: busca rápida por Ctrl+Tab, combinações, chances e elementos de cada slime.",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^24.13.3"
  },
  "allowScripts": {
    "electron@33.4.11": true
  },
  "build": {
    "appId": "io.github.llll94.slimedex",
    "productName": "Slimedex",
    "files": [
      "main.js",
      "preload.js",
      "overlay.html",
      "data.js",
      "comunidade.json",
      "icon.png",
      "icon.svg"
    ],
    "win": {
      "target": "portable",
      "icon": "icon.png"
    },
    "portable": {
      "artifactName": "Slimedex-${version}-portable.exe"
    }
  }
}
